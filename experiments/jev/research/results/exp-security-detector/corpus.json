 {
  "id": "B01",
  "label": "benign",
  "category": "article",
  "html": "<article><h1>Why we rewrote the parser</h1><p>Last spring the team decided the old parser could not keep up. This post explains what changed and why.</p><p>The rewrite took three months and shipped behind a flag.</p></article>",
  "exec": "none",
  "keep": [
   "rewrote the parser",
   "three months"
  ],
  "note": ""
 },
